# Required for local dev / production URL references (used in metadata, share cards)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional — leave blank to run in Local Demo Mode (no account/persistence backend).
# Fill both in to enable Supabase-backed authentication and data persistence.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Privacy-friendly analytics abstraction is disabled unless explicitly enabled.
NEXT_PUBLIC_ANALYTICS_ENABLED=false

# ---------------------------------------------------------------------------
# Optional production-only variables (do NOT set these on the client / never
# prefix with NEXT_PUBLIC_). Used only by server-only scripts such as
# supabase/seed.sql execution via the Supabase CLI or dashboard — never used
# at runtime by the Next.js app itself.
# SUPABASE_SERVICE_ROLE_KEY=
